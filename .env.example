# HTTP 服务端口
PORT=3000

# SQLite 数据目录；必须位于服务器本地磁盘
DATA_DIR=data

# 页面部署在域名根路径时用 /；子路径示例：/vote-tallying/
TALLY_BASE_PATH=/

# 整个站点的 HTTP Basic Auth；用户名不填时默认为 shrq
ACCESS_USERNAME=shrq
ACCESS_PASSWORD=

# 运行 pnpm admin:hash 生成；不要在示例文件或版本库中填写真实值
ADMIN_PASSWORD_HASH=

# Docker 构建和容器运行代理；留空表示不使用
# 代理运行在宿主机时使用 host.docker.internal，不要填写 127.0.0.1
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1
